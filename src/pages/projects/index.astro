---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Projects | Stalis" description="Projects by Stalis.">
  <section class="page-heading">
    <p class="eyebrow">Projects</p>
    <h1>What I am working on.</h1>
  </section>
  {
    projects.length ? (
      <div class="card-grid">
        {projects.map((project) => (
          <article class="card">
            <p class="eyebrow">{project.data.status}</p>
            <h2><a href={`/projects/${project.id.replace(/\.md$/, '')}/`}>{project.data.title}</a></h2>
            <p>{project.data.description}</p>
            {project.data.stack.length > 0 && <p class="tags">{project.data.stack.join(' · ')}</p>}
          </article>
        ))}
      </div>
    ) : (
      <p class="empty">Projects will appear here later.</p>
    )
  }
</BaseLayout>
