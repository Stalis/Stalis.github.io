---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} | Stalis`} description={project.data.description}>
  <article class="prose">
    <p class="eyebrow">{project.data.status}</p>
    {project.data.stack.length > 0 && <p class="tags">{project.data.stack.join(' · ')}</p>}
    <h1>{project.data.title}</h1>
    <Content />
    {project.data.repo && (
      <p class="links">
        <a href={project.data.repo}>Исходный код</a>
      </p>
    )}
  </article>
</BaseLayout>

{project.data.embedDemo && project.data.demo && <script define:vars={{ demoUrl: project.data.demo, demoTitle: `Демо: ${project.data.title}` }}>
  document.querySelectorAll('[data-demo]').forEach((demo) => {
    const player = document.createElement('div');
    const frame = document.createElement('iframe');
    const activate = document.createElement('button');
    const actions = document.createElement('p');
    const link = document.createElement('a');

    player.className = 'demo-player';
    frame.className = 'demo-frame';
    frame.src = demoUrl;
    frame.title = demoTitle;
    frame.loading = 'lazy';
    frame.tabIndex = -1;
    activate.className = 'demo-activate';
    activate.type = 'button';
    activate.textContent = 'Нажмите, чтобы включить управление';
    actions.className = 'links demo-links';
    link.className = 'button';
    link.href = demoUrl;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = 'Open demo in a new tab';

    player.append(frame, activate);
    actions.append(link);
    demo.append(player, actions);

    frame.addEventListener('load', () => {
      const documentElement = frame.contentDocument?.documentElement;
      if (!documentElement) return;

      const resize = () => {
        frame.style.height = `${documentElement.scrollHeight}px`;
      };

      resize();
      new ResizeObserver(resize).observe(documentElement);
    });

    activate.addEventListener('click', () => {
      demo.classList.add('is-active');
      frame.tabIndex = 0;
      frame.focus();
    });
  });
</script>
}
