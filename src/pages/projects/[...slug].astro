---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} | Stalis`} description={project.data.description}>
  <article class="prose">
    <p class="eyebrow">{project.data.status}</p>
    <h1>{project.data.title}</h1>
    <p class="lede">{project.data.description}</p>
    {project.data.stack.length > 0 && <p class="tags">{project.data.stack.join(' · ')}</p>}
    <Content />
    {project.data.embedDemo && project.data.demo && (
      <section class="demo">
        <h2>Демо</h2>
        <div class="demo-player" data-demo>
          <iframe class="demo-frame" src={project.data.demo} title={`Демо: ${project.data.title}`} loading="lazy" tabindex="-1"></iframe>
          <button class="demo-activate" type="button" data-demo-activate>Нажмите, чтобы включить управление</button>
        </div>
      </section>
    )}
    {(project.data.repo || project.data.demo) && (
      <p class="links">
        {project.data.repo && <a href={project.data.repo}>Исходный код</a>}
        {project.data.demo && <a class="button" href={project.data.demo} target="_blank" rel="noopener noreferrer">Open demo in a new tab</a>}
      </p>
    )}
  </article>
</BaseLayout>

<script>
  document.querySelectorAll('[data-demo]').forEach((demo) => {
    const activate = demo.querySelector('[data-demo-activate]');
    const frame = demo.querySelector('iframe');

    if (!(activate instanceof HTMLButtonElement) || !(frame instanceof HTMLIFrameElement)) return;

    activate.addEventListener('click', () => {
      demo.classList.add('is-active');
      frame.removeAttribute('tabindex');
      frame.focus();
    });
  });
</script>
