---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredProjectIds } from '../data/homepage';

if (featuredProjectIds.length > 4) {
  throw new Error('The home page supports up to four featured projects.');
}

const projects = await getCollection('projects', ({ data }) => !data.draft);
const projectsById = new Map(
  projects.map((project) => [project.id.replace(/\.md$/, ''), project]),
);
const missingProjectIds = featuredProjectIds.filter((id) => !projectsById.has(id));

if (missingProjectIds.length > 0) {
  throw new Error(`Unknown featured project IDs: ${missingProjectIds.join(', ')}`);
}

const featuredProjects = featuredProjectIds.map((id) => projectsById.get(id)!);
---

<BaseLayout
  title="Stanislav Babkin — Backend Engineer"
  description="The personal site of Stanislav Babkin: backend engineering, production systems, technical notes, and side projects."
>
  <section class="hero">
    <p class="eyebrow">Backend engineer · Belgrade</p>
    <h1>Hi, I’m Stanislav.</h1>
    <p class="hero-summary">
      I build backend systems and internal platforms, mostly with Python and C#/.NET. This is my
      corner of the web for notes about engineering, a few things I have worked on, and projects I
      make out of curiosity.
    </p>
    <div class="actions">
      <a class="button" href="#work">A few things I’ve worked on</a>
      <a class="text-link" href="https://www.linkedin.com/in/s-babkin/" rel="me">LinkedIn <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="https://github.com/Stalis" rel="me">GitHub <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="mailto:stalissss@outlook.com">Email <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="metrics" aria-labelledby="context-title">
    <h2 class="visually-hidden" id="context-title">Technical profile</h2>
    <article><strong>7+ years</strong><span>working across backend, platform, and systems engineering</span></article>
    <article><strong>Languages</strong><span>Python, C#/.NET, Go, C++, and C11</span></article>
    <article><strong>Backend stack</strong><span>ASP.NET, REST APIs, GraphQL, SQL, and data modelling</span></article>
    <article><strong>Infrastructure toolkit</strong><span>Jenkins, Terraform, Packer, Ansible, Docker, and Podman</span></article>
  </section>

  <section class="section profile" aria-labelledby="profile-title">
    <div class="section-heading">
      <p class="eyebrow">How I work</p>
      <h2 id="profile-title">From the first sketch to the production queue.</h2>
      <p class="section-intro">I’m most comfortable where application code, delivery systems, and day-to-day operations meet.</p>
    </div>
    <div class="capability-grid">
      <article><span class="capability-number">01</span><h3>Backend & internal tools</h3><p>APIs, service integrations, automation, and the small pieces of infrastructure that make other engineers’ work easier.</p></article>
      <article><span class="capability-number">02</span><h3>Architecture & old systems</h3><p>I like understanding why an existing system looks the way it does, documenting the constraints, and changing it a piece at a time.</p></article>
      <article><span class="capability-number">03</span><h3>Life after release</h3><p>Testing, rollout, incident response, and on-call are part of the engineering work, not a separate phase that begins after it.</p></article>
      <article><span class="capability-number">04</span><h3>Small technical teams</h3><p>I have hired and led engineers, split architecture into practical work, and kept writing code alongside the team.</p></article>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="section-heading split-heading">
      <div><p class="eyebrow">Selected work</p><h2 id="work-title">A few systems I know well.</h2></div>
      <p>Not a complete career history—just three examples that say something about the kind of engineering I enjoy.</p>
    </div>
    <div class="case-list">
      <article class="case case-featured">
        <div class="case-meta"><p class="eyebrow">CloudLinux</p><p>VM image build platform</p></div>
        <div class="case-content">
          <h3>Making a growing build system easier to extend</h3>
          <p class="case-problem">The original platform used a fixed base / payload / target structure. As the number and variety of images grew, unusual configurations took weeks to add and the complete weekly pipeline ran for 48–50 hours.</p>
          <p>I wrote the requirements and design for its second generation and worked with a team of three engineers on the implementation and gradual migration. The new system supports arbitrary Ansible layer sequences, reuses cached intermediate images, validates releases, and publishes artifacts to five cloud and virtualization platforms.</p>
          <ul class="result-list">
            <li><strong>400+ artifacts</strong> used by seven internal teams</li>
            <li><strong>14–24 hours</strong> for the complete build, upload, and test cycle</li>
            <li><strong>Same compute</strong> with roughly 20% more storage for the cache</li>
          </ul>
        </div>
      </article>
      <article class="case">
        <div class="case-meta"><p class="eyebrow">CloudLinux</p><p>Jenkins and configuration</p></div>
        <div class="case-content">
          <h3>Separating failures that did not belong together</h3>
          <p class="case-problem">A failed VM image could cause secondary failures for images that had already built successfully. Configuration changes also required too much recurring manual work.</p>
          <p>I moved the pipeline to one Jenkins job per artifact and generated those jobs from a structured YAML catalog in Git. Cascading failures went to zero, weekly routine work fell by 40%, and adding a configuration went from about a week to two days.</p>
        </div>
      </article>
      <article class="case">
        <div class="case-meta"><p class="eyebrow">Earlier .NET work</p><p>Services and hardware integration</p></div>
        <div class="case-content">
          <h3>Different layers of the same craft</h3>
          <p><strong>C2C parcel registration.</strong> I designed an ASP.NET and Entity Framework backend, a many-to-many data model, a Vue/Razor interface, and REST integrations with internal personal-data, billing, and shipment-status services through Service Discovery.</p>
          <p><strong>Sensor library integration.</strong> I built a C++/CLI wrapper and data adapter for an alternative contact-wire sensor, including automatic mirroring detection and synchronization-index correction at approximately 10,000 reads per second.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section technologies" aria-labelledby="technologies-title">
    <div class="section-heading">
      <p class="eyebrow">Toolbox</p>
      <h2 id="technologies-title">What I usually work with.</h2>
      <p class="section-intro">The list changes with the problem. These are the tools and areas I return to most often.</p>
    </div>
    <div class="technology-grid">
      <article class="technology-primary"><p class="eyebrow">Languages</p><h3>Python · C#/.NET · Go · C++</h3><p>Most of my professional work has been in Python and .NET, with Go and C/C++ for smaller services, tools, and systems projects.</p></article>
      <article><p class="eyebrow">Backend & data</p><h3>ASP.NET · REST · GraphQL · SQL</h3><p>Service design, data modelling, integrations, caching, PostgreSQL, MySQL, MS SQL Server, and MongoDB.</p></article>
      <article><p class="eyebrow">Build & delivery</p><h3>Jenkins · Terraform · Packer · Ansible</h3><p>Configuration-driven builds, repeatable environments, automated tests, publishing, and release workflows.</p></article>
      <article><p class="eyebrow">Production</p><h3>CI/CD · pytest · on-call</h3><p>Validation, rollback paths, incident response, and the feedback that only appears once a system is in regular use.</p></article>
      <article><p class="eyebrow">Hardware & experiments</p><h3>C11 · MCU · emulation</h3><p>I use side projects to explore lower layers: a virtual CPU with its own assembler and emulator, plus microcontroller projects including a paired pager and a small musical instrument.</p></article>
    </div>
  </section>

  <section class="section projects-section" id="projects" aria-labelledby="projects-title">
    <div class="section-heading split-heading">
      <div><p class="eyebrow">Side projects</p><h2 id="projects-title">Things I build to understand them.</h2></div>
      <p>Rendering, instruction sets, and other topics that are easier to appreciate after trying to make a small version yourself.</p>
    </div>
    <div class="project-list">
      {
        featuredProjects.map((project, index) => (
          <a class="project-row" href={`/projects/${project.id.replace(/\.md$/, '')}/`}>
            <span class="project-index">{String(index + 1).padStart(2, '0')}</span>
            <span>
              <strong>{project.data.title}</strong>
              <span class="project-description">{project.data.description}</span>
              {project.data.stack.length > 0 && <small>{project.data.stack.join(' · ')}</small>}
            </span>
            <span aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
    <p class="projects-footer"><a class="text-link" href="/projects/">View all projects <span aria-hidden="true">→</span></a></p>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <p class="eyebrow">Elsewhere</p>
    <h2 id="contact-title">Say hello.</h2>
    <p>You can find my code on GitHub, follow the professional version of the story on LinkedIn, or send me an email.</p>
    <div class="actions">
      <a class="button" href="mailto:stalissss@outlook.com">Email</a>
      <a class="text-link" href="https://www.linkedin.com/in/s-babkin/" rel="me">LinkedIn <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="https://github.com/Stalis" rel="me">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
